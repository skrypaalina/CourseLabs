@model Product
@{ ViewData["Title"] = "Add product"; }
<p class="eyebrow">Catalog</p><h1>Add product</h1>
<form asp-action="Create" method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="validation-message"></div>
    <div class="field"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="validation-message"></span></div>
    <div class="field"><label asp-for="Category"></label><input asp-for="Category" /><span asp-validation-for="Category" class="validation-message"></span></div>
    <div class="field"><label asp-for="Price"></label><input asp-for="Price" type="number" min="0.01" step="0.01" /><span asp-validation-for="Price" class="validation-message"></span></div>
    <div class="field"><label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea><span asp-validation-for="Description" class="validation-message"></span></div>
    <div class="page-actions"><button class="button" type="submit">Create product</button><a asp-action="Index">Cancel</a></div>
</form>
