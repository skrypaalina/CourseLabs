@model ProductIndexViewModel
@{ ViewData["Title"] = "Products"; }
<div class="page-heading"><div><p class="eyebrow">Catalog</p><h1>Products</h1></div><a class="button" asp-action="Create">＋ Add product</a></div>
<form method="get" asp-action="Index" class="filter-form">
    <div class="field"><label for="name">Name</label><input id="name" name="name" value="@Model.Name" placeholder="Coffee" /></div>
    <div class="field"><label for="category">Category</label><input id="category" name="category" value="@Model.Category" placeholder="Drinks" /></div>
    <div class="field"><label for="minPrice">Min price</label><input id="minPrice" name="minPrice" value="@Model.MinPrice" type="number" min="0" step="0.01" /></div>
    <div class="field"><label for="maxPrice">Max price</label><input id="maxPrice" name="maxPrice" value="@Model.MaxPrice" type="number" min="0" step="0.01" /></div>
    <div class="filter-actions"><button class="button" type="submit">Filter</button><a asp-action="Index">Clear</a></div>
</form>
<p class="result-count">@Model.Products.Count product(s) found</p>
<div class="table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>Type</th><th>Price</th><th>Actions</th></tr></thead><tbody>
@foreach (var product in Model.Products)
{
    <tr><td><a class="product-title" asp-action="Details" asp-route-id="@product.Id">@product.Name</a><small>@product.Description</small></td><td>@product.Category</td><td>@product.Type</td><td>$@product.Price.ToString("0.00")</td><td class="row-actions"><a asp-action="Edit" asp-route-id="@product.Id">Edit</a><a asp-action="Details" asp-route-id="@product.Id">View</a><a class="delete-link" asp-action="Delete" asp-route-id="@product.Id">Delete</a></td></tr>
}
@if (Model.Products.Count == 0) { <tr><td colspan="5" class="empty-state">No products match these filters.</td></tr> }
</tbody></table></div>

<section class="bulk-links"><h2>Edit prices by category</h2><p>Select a category to update its product prices together.</p><div class="category-links">
@foreach (var category in Model.Categories)
{
    <a class="category-chip" asp-action="EditPrices" asp-route-category="@category">@category <span>→</span></a>
}
</div></section>
